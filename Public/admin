<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin — Grant Access</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; margin: 0; }
    body { font-family: 'DM Sans', sans-serif; background: #f5f0e8; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px; }
    .card { max-width: 420px; width: 100%; background: #fff; border-radius: 12px; padding: 32px; box-shadow: 0 2px 16px rgba(30,58,95,0.06); }
    h1 { font-size: 20px; color: #1e3a5f; margin-bottom: 4px; }
    p.sub { font-size: 13px; color: #8a7e6e; margin-bottom: 24px; }
    label { display: block; font-size: 12px; font-weight: 600; color: #5a4e3e; margin-bottom: 6px; }
    input { width: 100%; padding: 10px 14px; font-size: 14px; border: 1.5px solid #a3988735; border-radius: 6px; outline: none; font-family: inherit; margin-bottom: 16px; }
    input:focus { border-color: #c8a84e; }
    button { width: 100%; padding: 12px; font-size: 14px; font-weight: 600; color: #fff; background: #1e3a5f; border: none; border-radius: 6px; cursor: pointer; }
    button:disabled { opacity: 0.6; cursor: wait; }
    .msg { padding: 10px 14px; border-radius: 6px; font-size: 12px; margin-top: 16px; }
    .msg.ok { background: #5a9a6a15; border: 1px solid #5a9a6a30; color: #5a9a6a; }
    .msg.err { background: #c45c4a10; border: 1px solid #c45c4a30; color: #c45c4a; }
    .warn { font-size: 11px; color: #8a7e6e; text-align: center; margin-top: 16px; }
  </style>
</head>
<body>
  <div class="card">
    <h1>Grant Free Access</h1>
    <p class="sub">Give a user access without payment. They must have an account first.</p>

    <label>Admin Secret</label>
    <input type="password" id="secret" placeholder="Your admin secret key">

    <label>User Email</label>
    <input type="email" id="email" placeholder="user@example.com">

    <label>Reason (optional)</label>
    <input type="text" id="reason" placeholder="Beta tester, reviewer, etc.">

    <button id="btn" onclick="grantAccess()">Grant Access</button>

    <div id="msg" style="display:none"></div>
    <p class="warn">This page is protected by your admin secret. Do not share the URL with the secret filled in.</p>
  </div>

  <script>
    async function grantAccess() {
      const secret = document.getElementById('secret').value;
      const email = document.getElementById('email').value;
      const reason = document.getElementById('reason').value;
      const btn = document.getElementById('btn');
      const msg = document.getElementById('msg');

      if (!secret || !email) {
        msg.style.display = 'block';
        msg.className = 'msg err';
        msg.textContent = 'Admin secret and email are required.';
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Granting...';
      msg.style.display = 'none';

      try {
        const res = await fetch('/.netlify/functions/grant-access', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'x-admin-key': secret,
          },
          body: JSON.stringify({ email, reason }),
        });
        const data = await res.json();

        msg.style.display = 'block';
        if (res.ok) {
          msg.className = 'msg ok';
          msg.textContent = '✓ ' + data.message;
          document.getElementById('email').value = '';
          document.getElementById('reason').value = '';
        } else {
          msg.className = 'msg err';
          msg.textContent = data.error || 'Something went wrong.';
        }
      } catch (err) {
        msg.style.display = 'block';
        msg.className = 'msg err';
        msg.textContent = 'Network error. Check your connection.';
      }

      btn.disabled = false;
      btn.textContent = 'Grant Access';
    }
  </script>
</body>
</html>
