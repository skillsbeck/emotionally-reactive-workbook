# ── Supabase ──
# Get these from: Supabase → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# This one is the "service_role" key (NOT the anon key)
# Used only by serverless functions — never expose in frontend
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ── Stripe ──
# Get these from: Stripe Dashboard → Developers → API Keys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_PRICE_ID=price_xxxxxxxxxxxx

# Get this after setting up the webhook (see PAYWALL_GUIDE.md)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# ── Admin ──
# Make up a long random string — used to protect the grant-access endpoint
ADMIN_SECRET=your-long-random-secret-here
